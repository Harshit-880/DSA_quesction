class Solution {
public:
    int n;
    vector<vector<vector<int>>> dp;

    int stoneGameIIUtil(vector<int>& piles, int person, int i, int m) {
        if (i >= n) return 0;  // Base case: no more piles to take

        if (dp[person][i][m] != -1) return dp[person][i][m];  // Check if already computed

        int result = (person == 1) ? INT_MIN : INT_MAX;  // Use INT_MIN for Alice (maximize), INT_MAX for Bob (minimize)
        int stones = 0;

        for (int x = 1; x <= min(2 * m, n - i); x++) {
            stones += piles[i + x - 1];  // Accumulate stones

            if (person == 1) {
                // Alice's turn: try to maximize her stones
                result = max(result, stones + stoneGameIIUtil(piles, 0, i + x, max(m, x)));
            } else {
                // Bob's turn: try to minimize Alice's score
                result = min(result, stoneGameIIUtil(piles, 1, i + x, max(m, x)));
            }
        }

        return dp[person][i][m] = result;  // Store and return the result
    }

    int stoneGameII(vector<int>& piles) {
        n = piles.size();
        dp = vector<vector<vector<int>>>(2, vector<vector<int>>(n, vector<int>(n + 1, -1)));  // Initialize memoization table
        return stoneGameIIUtil(piles, 1, 0, 1);  // Start with Alice, index 0, M=1
    }
};
